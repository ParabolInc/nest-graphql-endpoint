{
  "name": "nest-graphql-endpoint",
  "version": "1.0.0",
  "description": "Nest an external GraphQL endpoint in your schema",
  "author": "Matt Krick <matt.krick@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParabolInc/nest-graphql-endpoint.git"
  },
  "keywords": [
    "github",
    "graphql",
    "schema"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/nestGraphQLEndpoint.d.ts",
      "default": "./dist/nestGraphQLEndpoint.js"
    }
  },
  "main": "./dist/nestGraphQLEndpoint.js",
  "types": "./dist/nestGraphQLEndpoint.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json",
    "check": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "graphql": "^16.0.0"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.1.0 || ^11.0.0",
    "@graphql-tools/utils": "^12.0.3 || ^13.0.0",
    "dataloader": "^2.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "graphql": "^16.15.0",
    "typescript": "^7.0.2"
  }
}
